# Server
PORT=5000
CORS_ALLOWED_ORIGINS=http://localhost:3000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/saloon_erp

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=replace_with_a_strong_jwt_secret
JWT_REFRESH_SECRET=replace_with_a_strong_jwt_refresh_secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password

# SMS (AutobySMS)
AUTOBYSMS_API_KEY=your_autobysms_api_key
AUTOBYSMS_SENDER_ID=SMSSPT
AUTOBYSMS_TEMPLATE_ID=your_template_id

# Media (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Biometric Attendance (eTimeOffice)
BIOMETRIC_PROVIDER=eTimeOffice
ETIMEOFFICE_BASE_URL=https://api.etimeoffice.com/api
ETIMEOFFICE_CORPORATE_ID=your_corporate_id
ETIMEOFFICE_USERNAME=your_username
ETIMEOFFICE_PASSWORD=your_password
BIOMETRIC_SYNC_INTERVAL_MINUTES=5
