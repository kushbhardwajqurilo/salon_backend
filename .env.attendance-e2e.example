# Copy to .env.attendance-e2e only for the explicitly authorized temporary Attendance E2E database.
# The MongoDB account should be scoped only to saloon_erp_attendance_e2e on this test host.
ATTENDANCE_E2E_MONGO_URI=mongodb+srv://<test-user>:<test-password>@<authorized-test-cluster>.mongodb.net/saloon_erp_attendance_e2e?retryWrites=true&w=majority
ATTENDANCE_E2E_ALLOWED_MONGO_HOSTS=<authorized-test-cluster>.mongodb.net
ATTENDANCE_E2E_BACKEND_URL=http://127.0.0.1:5015/api/v1
ATTENDANCE_E2E_FRONTEND_URL=http://localhost:3000
ATTENDANCE_E2E_RUN_ID=attendance_local_run
ATTENDANCE_E2E_AUTHORIZED_EMAIL=attendance-authorized@example.invalid
ATTENDANCE_E2E_AUTHORIZED_PASSWORD=<dedicated-test-password>
ATTENDANCE_E2E_RESTRICTED_EMAIL=attendance-restricted@example.invalid
ATTENDANCE_E2E_RESTRICTED_PASSWORD=<dedicated-test-password>
